  (
    "grpcio-0.13.1rc1", "Metadata-Version: 2.0\nName: grpcio\nVersion: 0.13.1rc1\nSummary: UNKNOWN\nHome-page: UNKNOWN\nAuthor: UNKNOWN\nAuthor-email: UNKNOWN\nLicense: 3-clause BSD\nPlatform: UNKNOWN\nRequires-Dist: enum34 (>=1.0.4)\nRequires-Dist: futures (>=2.2.0)\nRequires-Dist: protobuf (>=3.0.0a3)\nRequires-Dist: six (>=1.10)\n\nUNKNOWN\n\n\n",
  ),
  (
    "grpcio-0.14.0rc1", "Metadata-Version: 2.0\nName: grpcio\nVersion: 0.14.0rc1\nSummary: UNKNOWN\nHome-page: UNKNOWN\nAuthor: UNKNOWN\nAuthor-email: UNKNOWN\nLicense: 3-clause BSD\nPlatform: UNKNOWN\nRequires-Dist: enum34 (>=1.0.4)\nRequires-Dist: futures (>=2.2.0)\nRequires-Dist: protobuf (>=3.0.0a3)\nRequires-Dist: six (>=1.10)\n\nUNKNOWN\n\n\n",
  ),
  (
    "grpcio-1.0.0rc1", "Metadata-Version: 2.0\nName: grpcio\nVersion: 1.0.0rc1\nSummary: UNKNOWN\nHome-page: UNKNOWN\nAuthor: UNKNOWN\nAuthor-email: UNKNOWN\nLicense: 3-clause BSD\nPlatform: UNKNOWN\nRequires-Dist: enum34 (>=1.0.4)\nRequires-Dist: futures (>=2.2.0)\nRequires-Dist: protobuf (>=3.0.0a3)\nRequires-Dist: six (>=1.5.2)\n\nUNKNOWN\n\n\n",
