  "divergences": [
    {
      "name": "cpython/host_python_version",
      "reason": "`cpython_tags` with an empty `python_version` reads `sys.version_info` in the reference; this library has no host to read and raises `TAG_VERSION_REQUIRED`, so the caller has to say which interpreter it is describing.",
      "reference_accepts": true
    },
    {
      "name": "compatible/host_python_version",
      "reason": "`compatible_tags` with an empty `python_version` reads `sys.version_info` in the reference; this library raises `TAG_VERSION_REQUIRED` instead.",
      "reference_accepts": true
    },
    {
      "name": "generic/host_interpreter",
      "reason": "`generic_tags` with an empty interpreter name asks the running interpreter what it is (`interpreter_name` / `interpreter_version`); this library raises `TAG_INTERPRETER_REQUIRED` instead.",
      "reference_accepts": true
    },
    {
      "name": "cpython/host_platforms",
      "reason": "`cpython_tags` with an empty platform list reads `platform_tags()` -- and on Linux that inspects the running libc. This library takes the empty list literally and raises `TAG_PLATFORMS_REQUIRED` instead of answering a different question than the caller asked.",
      "reference_accepts": true
    },
    {
      "name": "generic/host_platforms",
      "reason": "`generic_tags` with an empty platform list reads `platform_tags()` from the running machine; this library raises `TAG_PLATFORMS_REQUIRED` instead.",
      "reference_accepts": true
    },
    {
      "name": "compatible/host_platforms",
      "reason": "`compatible_tags` with an empty platform list reads `platform_tags()` from the running machine; this library raises `TAG_PLATFORMS_REQUIRED` instead.",
      "reference_accepts": true
    }
  ],
  "reference": "packaging.tags"
}
