///|
/// Documents the simple-index specification requires a client to reject,
/// as `(case name, document)`. Every one of them breaks exactly one rule
/// of RFC 8259 or of PEP 691, and the harness asserts that this library
/// rejects each one.
pub let index_bad_cases : Array[(String, String)] = [
  ("90_bad_json", "{\"name\": \"demo\", \"files\": [}\n"),
  ("91_no_name", "{\"files\": []}\n"),
  ("92_name_not_string", "{\"name\": 1, \"files\": []}\n"),
  ("93_files_not_array", "{\"name\": \"demo\", \"files\": {}}\n"),
  ("94_file_not_object", "{\"name\": \"demo\", \"files\": [1]}\n"),
  (
    "95_missing_filename", "{\"name\": \"demo\", \"files\": [{\"url\": \"u\", \"hashes\": {}}]}\n",
  ),
  (
    "96_hashes_not_object", "{\"name\": \"demo\", \"files\": [{\"filename\": \"f\", \"url\": \"u\", \"hashes\": []}]}\n",
  ),
  (
    "97_requires_python_type", "{\"name\": \"demo\", \"files\": [{\"filename\": \"f\", \"url\": \"u\", \"hashes\": {}, \"requires-python\": 3}]}\n",
  ),
  (
    "98_size_type", "{\"name\": \"demo\", \"files\": [{\"filename\": \"f\", \"url\": \"u\", \"hashes\": {}, \"size\": \"1\"}]}\n",
  ),
  (
    "99_versions_type", "{\"name\": \"demo\", \"files\": [], \"versions\": \"1.0\"}\n",
  ),
  ("9B_trailing_content", "{\"name\": \"demo\", \"files\": []} garbage\n"),
  (
    "9C_yanked_type", "{\"name\": \"demo\", \"files\": [{\"filename\": \"f\", \"url\": \"u\", \"hashes\": {}, \"yanked\": 1}]}\n",
  ),
]

