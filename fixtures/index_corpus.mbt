///|
/// Curated documents where this library deliberately answers differently
/// from Python's `json` module, as `(case name, does the reference accept
/// it)`. `index_cases/divergences.txt` explains each one, the generator
/// checks the reference's half and the harness checks both halves.
pub let index_divergences : Array[(String, Bool)] = [
  ("9A_duplicate_name", true),
]

///|
/// The documents behind `index_divergences`, as `(case name, document)`.
/// They are emitted as ordinary `index` records; the declaration above
/// only says which direction the difference goes.
pub let index_divergence_cases : Array[(String, String)] = [
  ("9A_duplicate_name", "{\"name\": \"a\", \"name\": \"b\", \"files\": []}\n"),
]

///|
