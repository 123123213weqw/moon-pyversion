///|
/// The documents where this library deliberately answers differently from the
/// specification, as `(case name, does the reference accept it)`. Divergence is
/// the point of the record: the harness asserts that the two answers really do
/// differ, and that the reference answers the way this table says.
/// `pylock_cases/divergences.txt` explains each one.
pub let pylock_divergences : Array[(String, Bool)] = [
  ("D6_lock_version_minor_not_implemented", true),
]

///|
/// The documents behind `pylock_divergences`, as `(case name, document)`. They
/// are emitted as ordinary `pylock` records; the declaration above only says
/// which direction the difference goes.
pub let pylock_divergence_cases : Array[(String, String)] = [
  (
    "D6_lock_version_minor_not_implemented", "lock-version = \"1.1\"\ncreated-by = \"mousebender\"\npackages = []\n",
  ),
]
