///|
/// Lock files derived from the 95 real PEP 691 index responses in
/// `index_corpus.mbt`: one per project, as `(project, document, projection)`.
/// The *documents* are constructed by tools/fetch_pylock_corpus.py, and the
/// file records inside them -- name, URL, sha256, size, upload time -- are the
/// index response's own. The index spells the UTC suffix `Z`; the document
/// writes the same instant as `+00:00`, because that is the spelling the
/// reference reader can reproduce from its `datetime`, and the instant is
/// unchanged. At most 3 versions and 6 file records are taken from each
/// response, so the corpus stays a corpus.
pub let pylock_pypi_cases : Array[(String, String, String)] = [
