///|
/// The documents where this library deliberately answers differently from the
/// specification, as `(case name, does the reference accept it)`. Divergence is
/// the point of the record: the harness asserts that the two answers really do
/// differ, and that the reference answers the way this table says.
/// `pylock_cases/divergences.txt` explains each one.
pub let pylock_divergences : Array[(String, Bool)] = [
  ("D1_created_by_missing", false),
  ("D2_created_by_empty", false),
  ("D3_redundant_version_next_to_a_source_tree", false),
  ("D4_file_record_without_hashes", false),
  ("D5_upload_time_not_utc", false),
  ("D7_version_omitted_on_a_file_list_entry", true),
  ("D6_lock_version_minor_not_implemented", true),
]

///|
/// The documents behind `pylock_divergences`, as `(case name, document)`. They
/// are emitted as ordinary `pylock` records; the declaration above only says
/// which direction the difference goes.
pub let pylock_divergence_cases : Array[(String, String)] = [
  ("D1_created_by_missing", "lock-version = \"1.0\"\npackages = []\n"),
  (
    "D2_created_by_empty", "lock-version = \"1.0\"\ncreated-by = \"\"\npackages = []\n",
  ),
  (
    "D3_redundant_version_next_to_a_source_tree", "lock-version = \"1.0\"\ncreated-by = \"moon-pyversion corpus\"\n\n[[packages]]\nname = \"spam\"\nversion = \"1.0\"\n[packages.vcs]\ntype = \"git\"\nurl = \"https://example.invalid/spam.git\"\ncommit-id = \"abc\"\n",
  ),
  (
    "D4_file_record_without_hashes", "lock-version = \"1.0\"\ncreated-by = \"moon-pyversion corpus\"\n\n[[packages]]\nname = \"spam\"\nversion = \"1.0\"\n[[packages.wheels]]\nname = \"spam-1.0-py3-none-any.whl\"\nurl = \"https://example.invalid/spam-1.0-py3-none-any.whl\"\n",
  ),
  (
    "D5_upload_time_not_utc", "lock-version = \"1.0\"\ncreated-by = \"moon-pyversion corpus\"\n\n[[packages]]\nname = \"spam\"\nversion = \"1.0\"\n[[packages.wheels]]\nname = \"spam-1.0-py3-none-any.whl\"\nurl = \"https://example.invalid/spam-1.0-py3-none-any.whl\"\nupload-time = 2025-01-25T11:30:10+02:00\nhashes = { sha256 = \"aa\" }\n",
  ),
  (
    "D7_version_omitted_on_a_file_list_entry", "lock-version = \"1.0\"\ncreated-by = \"moon-pyversion corpus\"\n\n[[packages]]\nname = \"spam\"\n[[packages.wheels]]\nname = \"spam-1.0-py3-none-any.whl\"\nurl = \"https://example.invalid/spam-1.0-py3-none-any.whl\"\nhashes = { sha256 = \"aa\" }\n",
  ),
  (
    "D6_lock_version_minor_not_implemented", "lock-version = \"1.1\"\ncreated-by = \"mousebender\"\npackages = []\n",
  ),
]
